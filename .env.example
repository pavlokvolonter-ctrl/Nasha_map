# Скопіюйте цей файл у .env.local і заповніть (Supabase → Project Settings → API).
# Без цих змінних сайт працює в «локальному режимі»: місця зберігаються лише в цьому браузері.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# За замовчуванням мапу бачать лише ті, чиї пошти є в таблиці editors.
# Поставте true, щоб мапу могли ПЕРЕГЛЯДАТИ всі з посиланням (редагувати — все одно лише дві пошти). Також потрібен рядок «public read» у schema.sql.
NEXT_PUBLIC_PUBLIC_VIEW=false
